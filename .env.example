# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=logs
POSTGRES_USER=logs
POSTGRES_PASSWORD=logspassword

# Elasticsearch
ES_HOST=http://elasticsearch:9200

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# API
API_HOST=0.0.0.0
API_PORT=8080

# Ingest agent
LOG_FILE=/var/log/app/app.log
INGEST_BATCH_SIZE=1000
INGEST_FLUSH_INTERVAL=1.0
INGEST_STATE_FILE=/tmp/ingest_state.json

# Anomaly detector
ANOMALY_ZSCORE_THRESHOLD=3.0
ANOMALY_MIN_COUNT=5
ANOMALY_INTERVAL=60
